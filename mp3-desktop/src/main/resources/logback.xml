<configuration>

    <!-- Appenders pour fichiers logs séparés -->
    <appender name="FILE_P1" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/programme1.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/programme1.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE_P2" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/programme2.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/programme2.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE_P3" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/programme3.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/programme3.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{15} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Definition des loggers par package/classe -->
    <logger name="com.mp3.desktop.Programme1" level="INFO" additivity="false">
        <appender-ref ref="FILE_P1" />
        <appender-ref ref="STDOUT" />
    </logger>

    <logger name="com.mp3.desktop.Programme2" level="INFO" additivity="false">
        <appender-ref ref="FILE_P2" />
        <appender-ref ref="STDOUT" />
    </logger>

    <logger name="com.mp3.desktop.Programme3" level="INFO" additivity="false">
        <appender-ref ref="FILE_P3" />
        <appender-ref ref="STDOUT" />
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
